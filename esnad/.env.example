APP_NAME=ESNAD
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://example.com
APP_TIMEZONE=Africa/Cairo

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_EG

# "shared" for cPanel shared hosting (Turbify), "vps" for a Linux VPS. See section 3.
APP_HOSTING_MODE=shared

# Long random value (at least 32 characters). Opens /install/check?token=...
# and the one-time /install/migrate?token=... . Leave empty to disable both.
INSTALL_TOKEN=

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12
HASH_DRIVER=argon2id

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

# MySQL 8 or MariaDB 10.6+, utf8mb4
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=esnad
DB_USERNAME=
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# Shared mode: database for sessions, cache and queue. VPS mode: redis.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Email over an HTTPS API (Resend or Brevo), never SMTP. "log" for staging.
MAIL_MAILER=log
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"
RESEND_KEY=

# Cloudflare R2 (S3-compatible), private bucket. Used from phase 6.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=true

# Brand and operator identity (footer, checkout, legal pages)
BRAND_AR=إسناد
BRAND_EN=ESNAD
ACCENT_HEX=#1F64A8
COMPANY_NAME=
CR_NO=
TAX_CARD_NO=
VAT_NO=
OFFICE_ADDRESS=
SUPPORT_PHONE=
SUPPORT_WHATSAPP=
SUPPORT_EMAIL=
DPO_NAME=
DPO_EMAIL=
PDPC_LICENCE_NO=
CONSENT_VERSION=2026-11-15

# One-time passwords: channels in order of preference
OTP_CHANNELS=whatsapp,sms
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_OTP_TEMPLATE=esnad_otp
WHATSAPP_API_VERSION=v21.0
WHATSAPP_DAILY_CAP=250
# "log" (staging only) or "http"
SMS_DRIVER=log
SMS_HTTP_URL=
SMS_HTTP_TOKEN=
SMS_SENDER_ID=ESNAD

# Cloudflare Turnstile
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Comma-separated IPs or CIDR ranges allowed into /admin. Empty allows all.
ADMIN_IP_ALLOWLIST=

VITE_APP_NAME="${APP_NAME}"
